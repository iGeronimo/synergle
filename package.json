{
  "name": "synergle",
  "version": "1.0.0",
  "private": true,
  "description": "Synergle: a free daily Connections-style puzzle game about Teamfight Tactics champions.",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "eleventy --serve --port=8080",
    "build": "npm run clean && eleventy",
    "clean": "node -e \"require('fs').rmSync('_site', { recursive: true, force: true })\"",
    "data:update": "tsx scripts/update-set-data.ts",
    "brand:assets": "tsx scripts/make-brand-assets.ts",
    "puzzles:generate": "tsx scripts/generate-puzzles.ts",
    "puzzles:validate": "tsx scripts/validate-puzzles.ts",
    "categories:report": "tsx scripts/report-categories.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/game-state.test.ts tests/dates.test.ts tests/generator.test.ts tests/text.test.ts",
    "check": "npm run typecheck && npm test && npm run puzzles:validate"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@fontsource/cinzel": "^5.3.0",
    "@types/node": "^18.19.130",
    "esbuild": "^0.28.2",
    "sharp": "^0.32.6",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
