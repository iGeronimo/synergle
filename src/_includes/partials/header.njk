{%- set navItems = [
  { href: "/", label: "Daily" },
  { href: "/practice/", label: "Practice" },
  { href: "/archive/", label: "Archive" },
  { href: "/champions/", label: "Champions" },
  { href: "/traits/", label: "Traits" }
] -%}
<header class="site-header">
  <div class="site-header-inner">
    <a class="logo" href="/" aria-label="{{ site.name }}, today's puzzle">
      <svg class="logo-mark" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
        <rect x="2" y="2" width="13" height="13" rx="3" fill="#1fb487"/>
        <rect x="17" y="2" width="13" height="13" rx="3" fill="#3a8be6"/>
        <rect x="2" y="17" width="13" height="13" rx="3" fill="#b552da"/>
        <rect x="17" y="17" width="13" height="13" rx="3" fill="#f2b53b"/>
      </svg>
      <span class="logo-text">{{ site.name }}</span>
    </a>
    <nav class="site-nav" aria-label="Main">
      {%- for item in navItems %}
      <a href="{{ item.href }}"{% if page.url == item.href or (item.href == "/archive/" and page.url == "/play/") %} aria-current="page"{% endif %}>{{ item.label }}</a>
      {%- endfor %}
    </nav>
    <div class="header-actions">
      <button class="icon-btn" type="button" data-open-dialog="help" aria-label="How to play" title="How to play">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9.5" fill="none" stroke="currentColor" stroke-width="2"/><path d="M9.4 9.3a2.7 2.7 0 0 1 5.2 1c0 1.8-2.6 2.3-2.6 4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><circle cx="12" cy="17.6" r="1.3" fill="currentColor"/></svg>
      </button>
      <button class="icon-btn" type="button" data-open-dialog="stats" aria-label="Statistics" title="Statistics">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 20V12M12 20V5M19 20v-9" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>
      </button>
    </div>
  </div>
</header>
